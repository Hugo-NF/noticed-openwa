# The real OpenWA session the cassettes are recorded against (README, "Recording the cassettes"). Copy this file to
# the git-ignored .env.test.local and fill it in; the specs read it only with OPENWA_RECORD=true, and VCR replaces
# these values with placeholders in the cassettes. Comments go on their own lines: a value is the rest of its line
# (quotes around it are dropped).

# The local OpenWA (README, "A local OpenWA"), its API key (docker compose exec openwa cat /app/data/.api-key) and a
# paired session's id (its status `ready`).
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# The session account's own number and WhatsApp name, as OpenWA shows them for the session: kept out of the
# cassettes (OpenWA's answer about the session carries both).
OPENWA_SESSION_PHONE=
OPENWA_SESSION_PUSH_NAME=

# A private CA's bundle, if OpenWA's certificate needs one; empty otherwise.
OPENWA_CA_FILE=

# E.164 numbers. Your own: it receives the test messages.
OPENWA_TEST_NUMBER=
# One with no WhatsApp account: the spec checks it and stops before sending if it has one.
OPENWA_TEST_NUMBER_NOT_ON_WHATSAPP=
# A WhatsApp group of yours, with your own number in it, as its chat id (<digits>@g.us): it receives the bulk delivery
# method's test messages.
OPENWA_TEST_GROUP=

# A public HTTPS URL you control, one that receives requests: the webhook specs register it, and unregister it
# when they end. OpenWA refuses a URL that doesn't resolve to a public address.
OPENWA_TEST_WEBHOOK_URL=
# Optional: the webhook specs' secret, 16 characters or more.
OPENWA_WEBHOOK_SECRET=
